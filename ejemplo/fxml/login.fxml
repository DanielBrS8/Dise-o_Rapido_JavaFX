<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>
<?import javafx.geometry.Insets?>

<StackPane xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.ejemplo.LoginController"
           prefWidth="400" prefHeight="550"
           style="-fx-background-color: #f0f2f5;">

    <VBox alignment="CENTER" spacing="0" maxWidth="340">

        <!-- Contenedor principal tipo tarjeta -->
        <VBox alignment="CENTER" spacing="8"
              style="-fx-background-color: white; -fx-background-radius: 10; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.15), 15, 0, 0, 3);">
            <padding>
                <Insets top="40" right="35" bottom="35" left="35"/>
            </padding>

            <!-- Título -->
            <Label fx:id="lblTitulo" text="Iniciar Sesión"
                   style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #333333;">
            </Label>

            <!-- Subtítulo -->
            <Label fx:id="lblSubtitulo" text="Accede a tu cuenta"
                   style="-fx-font-size: 13px; -fx-text-fill: #888888;">
                <VBox.margin>
                    <Insets bottom="15"/>
                </VBox.margin>
            </Label>

            <!-- Campo Email -->
            <TextField fx:id="txtEmail" promptText="Correo electrónico"
                       prefHeight="40" maxWidth="Infinity"
                       style="-fx-background-radius: 5; -fx-border-radius: 5; -fx-border-color: #ddd; -fx-padding: 8 12;">
            </TextField>

            <!-- Campo Contraseña -->
            <PasswordField fx:id="txtPassword" promptText="Contraseña"
                           prefHeight="40" maxWidth="Infinity"
                           style="-fx-background-radius: 5; -fx-border-radius: 5; -fx-border-color: #ddd; -fx-padding: 8 12;">
                <VBox.margin>
                    <Insets top="5"/>
                </VBox.margin>
            </PasswordField>

            <!-- Fila: Recordarme + Olvidé contraseña -->
            <HBox alignment="CENTER_LEFT" spacing="10">
                <VBox.margin>
                    <Insets top="5" bottom="5"/>
                </VBox.margin>
                <CheckBox fx:id="chkRecordarme" text="Recordarme"
                          style="-fx-font-size: 12px; -fx-text-fill: #666;">
                </CheckBox>
                <Region HBox.hgrow="ALWAYS"/>
                <Hyperlink fx:id="lnkOlvide" text="¿Olvidaste tu contraseña?"
                           style="-fx-font-size: 12px; -fx-text-fill: #3498db;">
                </Hyperlink>
            </HBox>

            <!-- Botón Iniciar Sesión -->
            <Button fx:id="btnLogin" text="Iniciar Sesión"
                    prefHeight="42" maxWidth="Infinity"
                    style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold; -fx-background-radius: 5; -fx-cursor: hand;">
                <VBox.margin>
                    <Insets top="10"/>
                </VBox.margin>
            </Button>

            <!-- Separador con "o" -->
            <HBox alignment="CENTER" spacing="10">
                <VBox.margin>
                    <Insets top="12" bottom="5"/>
                </VBox.margin>
                <Separator HBox.hgrow="ALWAYS"/>
                <Label text="o" style="-fx-text-fill: #aaa; -fx-font-size: 12px;"/>
                <Separator HBox.hgrow="ALWAYS"/>
            </HBox>

            <!-- Botón Crear Cuenta -->
            <Button fx:id="btnRegistro" text="Crear cuenta nueva"
                    prefHeight="42" maxWidth="Infinity"
                    style="-fx-background-color: transparent; -fx-text-fill: #3498db; -fx-font-size: 14px; -fx-border-color: #3498db; -fx-border-radius: 5; -fx-background-radius: 5; -fx-cursor: hand;">
                <VBox.margin>
                    <Insets top="5"/>
                </VBox.margin>
            </Button>

        </VBox>
    </VBox>
</StackPane>
